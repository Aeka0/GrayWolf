{
  // What an animation is for, and the entry that holds it. Every title reads its own slots into
  // one of these names; this says where a name belongs. Shared by every title, because where a
  // reload goes is a fact about the earlier title and not about the one being read.
  //
  // Derived from the earlier title's own export rather than written by hand: for each entry, what
  // its values are called across 480 weapons. It does not name an entry after what it holds -
  // dropAnim holds a putaway and raiseAnim a pullout - and this is where that is written down.
  //
  // A purpose here has to describe what the animation is *for*. Where an entry is set by only a
  // handful of weapons the reading above tends to swallow the weapon's own name instead - 24 rows
  // like "m14_crawl_b_empty" and "sword_zod_slash_in" were removed for that reason. None of them
  // had ever matched anything: a name particular to one weapon of one title cannot describe a
  // slot in another. Deriving these properly needs something other than the names.
  //
  // Left out: a name two entries share. The earlier title calls the normal and the empty form of
  // an animation the same thing, so "putaway" alone cannot say whether dropAnim or emptyDropAnim
  // is meant: gunbutt_swipe (meleeAnim/meleeChargeAnim/meleeMissAnim), idle (emptyIdleAnim/idleAnim), pullout (emptyRaiseAnim/raiseAnim). Settling those needs something other than the names.
  // fire was in that list and is no longer: comparing the two slots weapon by weapon settles it,
  // since a weapon without a distinct last shot points both at one asset and the rest name it.
  // A bare word is not a purpose. "up" and "down" were here once and would have caught any
  // animation ending that way - Cold War has six different slots whose animation ends in _up, and
  // only one of them is the sight coming up. Both titles name that one ads_base_up, so that is
  // what is asked for, and the shorter ads_up alongside it for the weapons that write it that way.
  //
  // Settled by hand, with the reason:
  //
  // - "idle" goes to idleAnim rather than emptyIdleAnim. A title carries the idle in several slots
  //   and the lowest is the plain one; in Black Ops 4 those slots hold the same animation as each
  //   other on 90% of weapons, so little rides on it. Cold War agrees on only 42%, so there the
  //   later slots are really different animations - they are simply not written, which is right.
  //
  // Settled by the earlier title's own habit rather than by naming: "putaway" and "pullout"
  // (raiseAnim or emptyRaiseAnim). Both titles carry them in three to five slots that hold
  // *different* animations on 92% to 97% of weapons, so which slot is the plain form is a real
  // question and picking the lowest would be a convention rather than a finding. Those entries
  // stay empty until something says which is which.
  "entries": {
    // The earlier title puts the *same* animation in each of these, so which slot is the plain
    // form and which the empty one never has to be answered - both are written from whichever
    // slot is read. It does this on 93% to 98% of weapons, and only where it sets the two about
    // as often as each other: altDropAnim reads the same as dropAnim but is set on 75 weapons
    // against 418, so it is not written along with it.
    "putaway":                     ["dropAnim", "emptyDropAnim", "altDropAnim"],
    "pullout":                     ["raiseAnim", "emptyRaiseAnim", "altRaiseAnim"],
    // The last shot has a slot of its own, so these no longer have to share an entry. A weapon
    // with no distinct last-shot animation points both slots at the same asset - that is why the
    // two agree on 72% of weapons and the rest read *_fire_last - so the pair is one purpose each
    // rather than one purpose holding two entries.
    // The underwater combat animations are the land ones: a weapon fired below water uses the
    // same fire, the same ads fire and the same idle on 95%, 91% and 95% of the weapons that set
    // both. They were being left empty because Black Ops 3 gives them entries of their own and
    // neither later title has a slot for them.
    "fire":                        ["fireAnim", "swimCombatFire"],
    "fire_intro":                  "fireIntroAnim",
    "fire_last":                   "lastShotAnim",
    "fire_ads":                    ["adsFireAnim", "swimCombatAdsFire"],

    // The reload has an opening and a closing animation of its own, which Black Ops 4 carries as
    // slots and nothing was reading. Only ten weapons set them, but the naming is not ambiguous:
    // eight of those ten put an animation ending reload_in in the one and reload_out in the other.
    "reload_in":                   "reloadStartAnim",
    "reload_out":                  "reloadEndAnim",
    "fire_ads_intro":              "adsFireIntroAnim",
    "fire_ads_last":               "adsLastShotAnim",
    // The melee entries hold one animation between them: 300 of the 360 weapons that set at
    // least four of them put the same one in every single one, and each entry matches meleeAnim
    // on 305 to 355 of 360. So a slot that holds the swipe fills all of them rather than the
    // three it used to, and the rest were being left empty for no reason. Black Ops 4 says
    // "swipe" where both titles otherwise say "gunbutt_swipe".
    "gunbutt_swipe":               ["meleeAnim", "meleeMissAnim", "meleeChargeAnim",
                                    "meleeAnimEmpty", "meleeChargeAnimAbove",
                                    "meleeChargeAnimHit", "meleeChargeAnimMiss",
                                    "meleeChargeAnimFatal"],
    "swipe":                       ["meleeAnim", "meleeMissAnim", "meleeChargeAnim",
                                    "meleeAnimEmpty", "meleeChargeAnimAbove",
                                    "meleeChargeAnimHit", "meleeChargeAnimMiss",
                                    "meleeChargeAnimFatal"],
    "idle":                        ["idleAnim", "emptyIdleAnim", "swimCombatIdle"],
    "idle_empty":                  "emptyIdleAnim",
    "crawl_b":                     "crawlBackAnim",
    "crawl_f":                     "crawlForwardAnim",
    "crawl_in":                    "crawlInAnim",
    "crawl_l":                     "crawlLeftAnim",
    "crawl_out":                   "crawlOutAnim",
    "crawl_r":                     "crawlRightAnim",
    "ads_base_down":               "adsDownAnim",
    "ads_down":                    "adsDownAnim",
    "fall":                        "fallAnim",
    "first_raise":                 "firstRaiseAnim",
    "juke_l":                      "jukeLeftAnim",
    "juke_l_ads":                  "jukeLeftADSAnim",
    "juke_r":                      "jukeRightAnim",
    "juke_r_ads":                  "jukeRightADSAnim",
    "jump":                        "jumpAnim",
    "jump_land":                   "jumpLandAnim",
    "mantle_over":                 "trmOverAnim",
    "mantle_over_l":               "trmOverLeftAnim",
    "mantle_over_r":               "trmOverRightAnim",
    "mantle_wall_in":              "trmInAnim",
    "mantle_wall_in_low":          "trmInLowAnim",
    "mantle_wall_out_low":         "trmOutLowAnim",
    "melee_miss":                  "meleePowerAnim",
    "pullout_quick":               "quickRaiseAnim",
    "putaway_quick":               "quickDropAnim",
    "rechamber":                   "rechamberAnim",
    "rechamber_ads":               "adsRechamberAnim",
    "reload":                      "reloadAnim",
    "reload_empty":                "reloadEmptyAnim",
    "reload_quick":                "reloadQuickAnim",
    "reload_quick_empty":          "reloadQuickEmptyAnim",
    "sprint_in":                   "sprintInAnim",
    "sprint_loop":                 "sprintLoopAnim",
    "sprint_out":                  "sprintOutAnim",
    "ads_base_up":                 "adsUpAnim",
    "ads_up":                      "adsUpAnim",
    "lower_up":                    "adsUpOtherScopeAnim",
    "walk":                        "walkAnim",
    "walk_f":                      "walkAnim",
    "wallrun_in":                  "wallRunInAnim",
    "wallrun_loop":                "wallRunLoopAnim",
    "wallrun_out":                 "wallRunOutAnim",

    // Swimming. Both later titles carry these as slots of their own and neither had anywhere to
    // put them, so every swim animation was being dropped. The purpose each entry answers to was
    // read the same way as the rest of this table - what the 480 weapons call the animation they
    // put in it - and every one of these agreed on 353 weapons or more.
    //
    // The two sprint loops are deliberately absent: Black Ops 3 fills them with a shared animation
    // of the player's own hands rather than the weapon's, so they are written as that instead.
    "swim_uw_idle":                "swimIdleLoop",
    "swim_uw_in":                  "swimMovingIn",
    "swim_uw_f":                   "swimMovingForward",
    "swim_uw_b":                   "swimMovingBackward",
    "swim_uw_l":                   "swimMovingLeft",
    "swim_uw_r":                   "swimMovingRight",
    "swim_uw_out":                 "swimMovingOut",
    "swim_uw_sprint_in":           "swimSprintIn",
    "swim_uw_sprint_out":          "swimSprintOut",

    // One animation answering two entries, as the corpus has it: 357 weapons point swimRaise and
    // 341 point swimQuickRaise at the same pullout, and swim_to_land fills the transition and the
    // combat idle it leads into.
    "swim_uw_pullout":             ["swimRaise", "swimQuickRaise"],
    "swim_uw_putaway":             "swimDrop",
    "swim_to_land":                ["swimTransitionToLand", "swimCombatIdleIn"],
    "swim_from_land":              ["swimTransitionFromLand", "swimCombatOut"],

    // The twin of mantle_wall_out_low, which was here already.
    "mantle_wall_out":             "trmOutAnim"
  }
}