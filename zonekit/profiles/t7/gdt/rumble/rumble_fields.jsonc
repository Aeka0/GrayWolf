// rumble from HydraX's Rumble.cs RumbleAsset (Pack 1), by hand: the keys as the Mod Tools write
// them (highRumbleFile, lowRumbleFile, pulseBoneTag; HydraX: highrumblefile, lowrumblefile,
// pulseBoneTagPointer) and the two durations the game keeps in milliseconds in seconds, as the
// Mod Tools' rumble.gdf ("Time in seconds").
{
 "struct": "rumble",
 "pool": 71,
 "source": "HydraX (github.com/Scobalula/HydraX, GPL-3.0), Games/BlackOps3/AssetPools/Rumble.cs",
 "fields": [
  { "offset": "0x8", "name": "duration", "form": "msec" },
  { "offset": "0xc", "name": "range", "form": "float" },
  { "offset": "0x10", "name": "highRumbleFile", "form": "asset" },
  { "offset": "0x18", "name": "lowRumbleFile", "form": "asset" },
  { "offset": "0x20", "name": "fadeWithDistance", "form": "int" },
  { "offset": "0x24", "name": "broadcast", "form": "int" },
  { "offset": "0x28", "name": "camShakeScale", "form": "float" },
  { "offset": "0x2c", "name": "camShakeDuration", "form": "msec" },
  { "offset": "0x30", "name": "camShakeRange", "form": "float" },
  { "offset": "0x34", "name": "pulseRadiusOuter", "form": "float" },
  { "offset": "0x38", "name": "pulseScale", "form": "float" },
  { "offset": "0x3c", "name": "pulseBoneTag", "form": "scriptstring" }
 ]
}
