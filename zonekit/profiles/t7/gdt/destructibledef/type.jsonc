{
  // destructibledef (2), HydraX DestructibleDef.cs (unfinished there): a converter writing the
  // destructibledef entry and one destructiblepiece entry per piece (the zone keeps the pieces
  // inline, unnamed: <def>_piece<index>). destructibledef_fields.jsonc is a piece's layout.
  "zone_type": "destructibledef",
  "converter": "t7_destructibledef",
  "piece_size": "0x3c8",
  // the stage flags' bits (flags<stage>), as destructiblepiece.gdf's checkboxes; "staged": only the
  // stages after the first have the key
  "flags": {
    "explosiveDamageOnly": 0,
    "parentDamage": 1,
    "physicsParent": 2,
    "meleeDamage": 3,
    "breakOnEntityDeath": { "bit": 4, "staged": true },
    "includeChildren": 5
  },
  // the GDF's 64 piece slots: an unused one as destructibledef.awi defaults it
  "slots": 64,
  "slot_defaults": {
    "piece#": "", "piece#Health": "200", "parentPiece#": "-1", "parentDamage#": "0", "damageEntity#": "100",
    "physConstraint#": "", "burnEffect#": "", "damageSound#": "", "burnSound#": "", "pieceLabel#": "",
    "bulletDamageScale#": "1", "explosiveDamageScale#": "1", "meleeDamageScale#": "1", "impactDamageScale#": "1"
  },
  // the Linker's damage sound when the GDT leaves it empty (and "NULL" for none): written back as
  // "" and "NULL"
  "damage_sound_default": "dst_{def}_d{index}",
  "def_constants": { "configstringFileType": "DESTRUCTIBLEDEF", "advancedEditing": "1", "liveupdatereset": "0" },
  "piece_constants": { "configstringFileType": "DESTRUCTIBLEPIECE" }
}
